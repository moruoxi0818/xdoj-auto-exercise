# 本文件只是模板，请不要把填好的版本发给别人
# 首次运行程序会自动复制成 .env，再在网页弹窗里填写即可
# AI Key 申请：https://open.bigmodel.cn  ->  API Keys

AI_API_KEY=
AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4.5-flash
AI_FALLBACK_MODEL=glm-4-flash
AI_VISION_MODEL=glm-4.5v
AI_MAX_TOKENS=4096

XDOJ_USER=
XDOJ_PASS=

# 文本编码：默认 gbk（Windows 中文环境 / 评测机一致）；想用 UTF-8 改成 utf-8
XDOJ_ENCODING=gbk
